# EngineerForge AI — environment template. Copy to .env and fill values.
# Secrets are read from the OS keychain at runtime; .env is for local dev only.

# --- Data plane (Postgres / Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/efc
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side ONLY — never ship to renderer

# --- AI providers ---
ANTHROPIC_API_KEY=                  # Claude (primary)
OPENAI_API_KEY=                     # optional
OLLAMA_HOST=http://localhost:11434  # local/offline models

# --- Engine ---
EFC_ENGINE_HOST=127.0.0.1
EFC_ENGINE_PORT=0                   # 0 = ephemeral port chosen at spawn
EFC_ENGINE_PYTHON=                  # optional path to the pinned Python 3.12 interpreter
EFC_ENGINE_LOG_LEVEL=info
