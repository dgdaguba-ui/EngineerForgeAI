{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", "packages/config/**"],
  "tasks": {
    "codegen": {
      "cache": true,
      "outputs": ["src/generated/**", "src/engine-client/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", ".next/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "codegen"]
    }
  }
}
