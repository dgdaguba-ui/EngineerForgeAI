# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Windows scripts that require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.stl binary
*.3mf binary
*.step binary
*.blend binary
*.glb binary
*.fbx binary
*.exe binary
