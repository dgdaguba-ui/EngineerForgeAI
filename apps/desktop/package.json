{
  "name": "desktop",
  "productName": "EngineerForge AI",
  "version": "0.1.0",
  "private": true,
  "description": "EngineerForge AI desktop shell (Electron main + preload).",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "smoke": "node scripts/build.mjs && electron . --smoke",
    "test": "vitest run"
  },
  "dependencies": {
    "@efc/ipc-contracts": "workspace:*"
  },
  "devDependencies": {
    "@efc/config": "workspace:*",
    "@types/node": "^22.10.0",
    "electron": "^35.0.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
